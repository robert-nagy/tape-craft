{
  "name": "tape-craft",
  "version": "1.0.0",
  "description": "Tool using Spotify API that makes sense of your Liked Songs and crafts playlists based on your needs.",
  "scripts": {
    "test": "vitest run --passWithNoTests --exclude 'tests/integration/**' --exclude 'tests/e2e/**' --exclude 'node_modules/**'",
    "test:integration": "vitest run --passWithNoTests --dir tests/integration",
    "test:e2e": "playwright test --pass-with-no-tests",
    "start": "node src/server.js",
    "migrate": "node src/migrate.js"
  },
  "keywords": [],
  "type": "module",
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testcontainers/postgresql": "^12.2.2",
    "testcontainers": "^12.2.2",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/static": "^11.0.0",
    "fastify": "^5.12.8",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1"
  }
}
