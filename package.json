{
  "name": "tape-craft",
  "version": "1.0.0",
  "description": "Tool using Spotify API that makes sense of your Liked Songs and crafts playlists based on your needs.",
  "scripts": {
    "build": "dotnet build",
    "start": "dotnet run --project src/TapeCraft.Api",
    "migrate": "dotnet run --project src/TapeCraft.Api -- migrate",
    "test": "npm test --workspace web && dotnet test --project tests/TapeCraft.UnitTests",
    "test:integration": "dotnet test --project tests/TapeCraft.IntegrationTests",
    "test:e2e": "playwright test"
  },
  "keywords": [],
  "type": "module",
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.65.1"
  },
  "engines": {
    "node": ">=22.22"
  },
  "workspaces": [
    "web"
  ]
}
